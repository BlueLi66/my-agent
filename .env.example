# Required: Anthropic API key and primary model ID
ANTHROPIC_API_KEY=sk-ant-xxx
MODEL_ID=claude-sonnet-4-6

# Optional: Custom Anthropic-compatible base URL (e.g., MiniMax, GLM, Kimi, DeepSeek)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Fallback model used after consecutive HTTP 529 overloaded responses
# FALLBACK_MODEL_ID=claude-haiku-4-5

# Optional: Lightweight evaluator model reserved for Goal Loop (M6 / s17)
# GOAL_EVALUATOR_MODEL_ID=claude-haiku-4-5
